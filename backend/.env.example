# Copy to backend/.env and fill in. Never commit .env.

# Database (SQLAlchemy / Alembic)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/literacy_lion

# Admin panel: secret used to sign session cookies (use a long random string)
ADMIN_SESSION_SECRET=

# Seed script (scripts/create_admin.py)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI provider key (agent/agent.py)
AI_API_KEY=

# Assistant coverage thresholds (required at startup; tune against real queries)
STRONG_MATCH_THRESHOLD=
MIN_MATCH_THRESHOLD=
